# Copy to .env.local and use Sandbox credentials only.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Optional shopping AI. Keep disabled until API billing and local limits are reviewed.
OPENAI_API_KEY=
ACCESSCART_AI_ENABLED=false

# Empty means local-only http://127.0.0.1:4173.
# Public mode requires an HTTPS origin with no trailing slash and this private passphrase.
ACCESSCART_ORIGIN=
ACCESSCART_PASSPHRASE=

# Public deployment only: absolute persistent disk path. Leave blank for local .local/.
ACCESSCART_DATA_DIR=
# Render sets PORT and RENDER_EXTERNAL_URL automatically; local defaults remain 4173.

# On first cloud start only, carry existing reserved AI usage; does not override a saved ledger.
ACCESSCART_INITIAL_RESERVED_YEN=0
